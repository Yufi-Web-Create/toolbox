# Vercel / Next.js
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: defaults to the deployed OmniBox Render bridge
LINE_BRIDGE_URL=https://omnibox-line-bridge.onrender.com

# Render LINE provider bridge
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
OMNIBOX_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
BRIDGE_SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
PORT=8787
