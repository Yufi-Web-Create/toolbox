# Vercel / Next.js
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional: defaults to the deployed OmniBox Render bridge
LINE_BRIDGE_URL=https://omnibox-line-bridge.onrender.com

# Render LINE provider bridge
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
OMNIBOX_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000
BRIDGE_SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
PORT=8787


# OmniBox OAuth provider apps (Vercel / Next.js)
OMNIBOX_INSTAGRAM_CLIENT_ID=your-meta-app-id
OMNIBOX_INSTAGRAM_CLIENT_SECRET=your-meta-app-secret
# Optional
# OMNIBOX_INSTAGRAM_SCOPES=instagram_business_basic instagram_business_manage_messages instagram_business_content_publish

OMNIBOX_X_CLIENT_ID=your-x-oauth-client-id
OMNIBOX_X_CLIENT_SECRET=your-x-oauth-client-secret
# Optional
# OMNIBOX_X_SCOPES=tweet.read tweet.write users.read dm.read dm.write offline.access

OMNIBOX_GOOGLE_CLIENT_ID=your-google-oauth-client-id
OMNIBOX_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Optional
# OMNIBOX_GOOGLE_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send
